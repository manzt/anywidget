<div class="inline-flex items-center gap-[0.25em] rounded-full bg-[var(--theme-code-inline-bg)] p-[0.33em_0.67em] outline outline-1 outline-transparent" role="group" aria-label="Color theme">
  <label class="relative flex items-center justify-center text-[var(--theme-code-inline-text)] opacity-50 focus-within:outline-2 focus-within:outline-transparent focus-within:[box-shadow:0_0_0_0.08em_var(--theme-accent),0_0_0_0.12em_white] [&.checked]:text-[var(--theme-accent)] [&.checked]:opacity-100" data-theme-option="light">
    <svg
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 20 20"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
        clip-rule="evenodd"
      />
    </svg>
    <input class="absolute inset-0 -z-1 opacity-0" type="radio" name="theme-toggle" value="light" aria-label="Use light theme" />
  </label>
  <label class="relative flex items-center justify-center text-[var(--theme-code-inline-text)] opacity-50 focus-within:outline-2 focus-within:outline-transparent focus-within:[box-shadow:0_0_0_0.08em_var(--theme-accent),0_0_0_0.12em_white] [&.checked]:text-[var(--theme-accent)] [&.checked]:opacity-100" data-theme-option="dark">
    <svg
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 20 20"
      fill="currentColor"
    >
      <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
    </svg>
    <input class="absolute inset-0 -z-1 opacity-0" type="radio" name="theme-toggle" value="dark" aria-label="Use dark theme" />
  </label>
</div>

<script>
  const options = document.querySelectorAll<HTMLInputElement>('input[name="theme-toggle"]');
  const savedTheme = localStorage.getItem("theme");
  const theme =
    savedTheme === "light" || savedTheme === "dark"
      ? savedTheme
      : window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";

  function applyTheme(value: string) {
    const dark = value === "dark";
    document.documentElement.classList.toggle("theme-dark", dark);
    document.documentElement.classList.toggle("dark", dark);
    for (const option of options) {
      const checked = option.value === value;
      option.checked = checked;
      option.closest("label")?.classList.toggle("checked", checked);
    }
  }

  applyTheme(theme);
  for (const option of options) {
    option.addEventListener("change", () => {
      localStorage.setItem("theme", option.value);
      applyTheme(option.value);
    });
  }
</script>
