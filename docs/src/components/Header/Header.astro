---
import * as CONSTS from "../../consts";
import AnyWidgetLogo from "./AnyWidgetLogo.astro";
import Search from "./Search.astro";
import SidebarToggle from "./SidebarToggle.astro";
import SkipToContent from "./SkipToContent.astro";
import ThemeToggleButton from "./ThemeToggleButton.astro";

type Props = {
	hideMenu?: boolean;
};

const { hideMenu = false } = Astro.props as Props;
---

<header class="sticky top-0 z-11 flex h-[var(--theme-navbar-height)] w-full items-center justify-center overflow-hidden bg-[var(--theme-navbar-bg)] min-[50em]:static min-[50em]:py-8">
	<SkipToContent />
	<nav class="flex w-full max-w-[82em] items-center justify-end gap-4 px-4" title="Top Navigation">
		<div class="flex w-[30px] shrink-0 flex-1 overflow-hidden text-[2rem] leading-none font-semibold min-[50em]:z-0 min-[50em]:m-0 min-[50em]:w-auto">
			<a class="group -mx-[0.25em] -my-[0.5em] flex px-[0.25em] py-[0.5em] font-bold no-underline" href="/">
				<AnyWidgetLogo size={38} />
				<h1 class="m-0 hidden pt-[0.1rem] pl-2 text-[var(--theme-text)] transition-transform duration-200 ease-in [font:inherit] group-hover:-mt-[0.04rem] group-hover:-ml-[0.04rem] group-focus:-mt-[0.04rem] group-focus:-ml-[0.04rem] min-[50em]:block">{CONSTS.SITE.title}</h1>
			</a>
		</div>
		<div class="grow-[0.8]"></div>
		<a
			href="https://github.com/manzt/anywidget"
			target="_blank"
			rel="noreferrer"
			aria-label="GitHub Repository"
			class="fill-[var(--theme-text-light)]"
		>
			<svg aria-hidden="true" viewBox="0 0 24 24" class="w-7 h-7">
				<path d="M12.5.75C6.146.75 1 5.896 1 12.25c0 5.089 3.292 9.387 7.863 10.91.575.101.79-.244.79-.546 0-.273-.014-1.178-.014-2.142-2.889.532-3.636-.704-3.866-1.35-.13-.331-.69-1.352-1.18-1.625-.402-.216-.977-.748-.014-.762.906-.014 1.553.834 1.769 1.179 1.035 1.74 2.688 1.25 3.349.948.1-.747.402-1.25.733-1.538-2.559-.287-5.232-1.279-5.232-5.678 0-1.25.445-2.285 1.178-3.09-.115-.288-.517-1.467.115-3.048 0 0 .963-.302 3.163 1.179.92-.259 1.897-.388 2.875-.388.977 0 1.955.13 2.875.388 2.2-1.495 3.162-1.179 3.162-1.179.633 1.581.23 2.76.115 3.048.733.805 1.179 1.825 1.179 3.09 0 4.413-2.688 5.39-5.247 5.678.417.36.776 1.05.776 2.128 0 1.538-.014 2.774-.014 3.162 0 .302.216.662.79.547C20.709 21.637 24 17.324 24 12.25 24 5.896 18.854.75 12.5.75Z"></path>
			</svg>
		</a>
		<ThemeToggleButton />
		<Search />
		{!hideMenu && <SidebarToggle />}
	</nav>
</header>
