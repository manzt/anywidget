---
import { SIDEBAR } from "../../consts";
import { getLanguageFromURL } from "../../languages";

type Props = {
	currentPage: string;
};

const { currentPage } = Astro.props as Props;
const currentPageMatch = currentPage.endsWith("/")
	? currentPage.slice(1, -1)
	: currentPage.slice(1);
const langCode = getLanguageFromURL(currentPage);
const sidebar = SIDEBAR[langCode];
---

<nav class="mr-4 w-full" aria-labelledby="grid-left">
	<ul class="nav-groups h-full max-h-screen overflow-x-visible overflow-y-auto py-8 min-[50em]:py-0 [&>:first-child]:pt-[var(--doc-padding)] [&>:last-child]:mb-[var(--theme-navbar-height)] [&>:last-child]:pb-8 [&>li+li]:mt-8">
		{
			Object.entries(sidebar).map(([header, children]) => (
				<li>
					<h2 class="m-0 text-base font-bold min-[50em]:px-4 min-[50em]:py-[0.2rem]">{header}</h2>
					<ul>
						{children.map((child) => {
							const url = Astro.site?.pathname + child.link;
							return (
								<li>
									<a
										class="m-px block p-[0.3rem_1rem] text-base text-[var(--theme-text-lighter)] no-underline [font:inherit] hover:bg-[var(--theme-bg-accent)] focus:bg-[var(--theme-bg-accent)] aria-[current=page]:bg-[var(--theme-bg-accent)] aria-[current=page]:font-medium aria-[current=page]:text-[var(--theme-text)] min-[50em]:px-4 min-[50em]:py-[0.2rem]"
										href={url}
										aria-current={
											currentPageMatch === child.link ? "page" : false
										}
									>
										{child.text}
									</a>
								</li>
							);
						})}
					</ul>
				</li>
			))
		}
	</ul>
</nav>

<script is:inline>
	window.addEventListener("DOMContentLoaded", () => {
		var target = document.querySelector('[aria-current="page"]');
		if (target && target.offsetTop > window.innerHeight - 100) {
			document.querySelector(".nav-groups").scrollTop = target.offsetTop;
		}
	});
</script>
