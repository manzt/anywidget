<div class="gallery" id="widget-gallery" aria-live="polite">
  <p data-gallery-status>Loading community widgets…</p>
</div>

<script>
  type Repo = {
    repo: string;
    description: string;
    stars: number;
    image?: string;
    gif?: string;
  };

  const manifestUrl = new URL(
    "https://manzt.github.io/built-with-anywidget/manifest-complete.json",
  );
  const gallery = document.querySelector<HTMLElement>("#widget-gallery");

  function formatStars(stars: number) {
    if (stars < 1000) return String(stars);
    return stars % 1000 === 0 ? `${Math.floor(stars / 1000)}k` : `${(stars / 1000).toFixed(1)}k`;
  }

  function createCard(item: Repo) {
    const url = `https://github.com/${item.repo}`;
    const card = document.createElement("article");
    card.className =
      "group flex max-h-64 w-full flex-col justify-between overflow-hidden rounded-lg border border-teal-200 bg-teal-50";

    const content = document.createElement("div");
    content.className = "px-3 py-2";

    const heading = document.createElement("div");
    heading.className = "flex items-center justify-between gap-3";

    const link = document.createElement("a");
    link.className = "truncate text-sm font-semibold text-gray-600 hover:text-gray-700";
    link.href = url;
    link.target = "_blank";
    link.rel = "noreferrer";
    link.textContent = item.repo;
    heading.append(link);

    if (item.stars) {
      const stars = document.createElement("a");
      stars.className = "shrink-0 text-sm text-gray-500 hover:text-gray-600";
      stars.href = `${url}/stargazers`;
      stars.target = "_blank";
      stars.rel = "noreferrer";
      stars.textContent = `★ ${formatStars(item.stars)}`;
      heading.append(stars);
    }

    const description = document.createElement("p");
    description.className = "line-clamp-2 text-sm text-gray-600 group-hover:line-clamp-none";
    description.textContent = item.description;
    content.append(heading, description);
    card.append(content);

    if (item.image) {
      const imageLink = document.createElement("a");
      imageLink.href = url;
      imageLink.target = "_blank";
      imageLink.rel = "noreferrer";
      imageLink.ariaLabel = `View ${item.repo} on GitHub`;

      const image = document.createElement("img");
      image.className = "image-preview w-full";
      image.loading = "lazy";
      image.src = new URL(item.image, manifestUrl).href;
      image.alt = `Preview of ${item.repo}`;
      if (item.gif) image.dataset.gif = new URL(item.gif, manifestUrl).href;
      imageLink.append(image);
      card.append(imageLink);
    }

    return card;
  }

  async function loadGallery() {
    if (!gallery) return;
    try {
      const response = await fetch(manifestUrl);
      if (!response.ok) throw new Error(`Request failed with status ${response.status}`);
      const repos = (await response.json()) as Repo[];
      repos.sort((a, b) => Number(Boolean(b.image)) - Number(Boolean(a.image)) || b.stars - a.stars);
      gallery.replaceChildren(...repos.map(createCard));

      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const image = entry.target.querySelector<HTMLImageElement>(".image-preview");
          if (image?.dataset.gif) image.src = image.dataset.gif;
          observer.unobserve(entry.target);
        }
      });
      gallery.querySelectorAll("article").forEach((card) => observer.observe(card));
    } catch {
      const message = document.createElement("p");
      message.append("The gallery could not be loaded. ");
      const link = document.createElement("a");
      link.href = "https://manzt.github.io/built-with-anywidget/";
      link.textContent = "Browse it directly.";
      message.append(link);
      gallery.replaceChildren(message);
    }
  }

  void loadGallery();
</script>

<style>
  .gallery {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
</style>
