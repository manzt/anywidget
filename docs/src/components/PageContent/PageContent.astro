---
import type { MarkdownHeading } from "astro";
import type { Frontmatter } from "../../consts";
import MoreMenu from "../RightSidebar/MoreMenu.astro";
import TableOfContents from "../RightSidebar/TableOfContents.astro";

type Props = {
	frontmatter: Omit<Frontmatter, "layout">;
	headings: MarkdownHeading[];
	githubEditUrl: string;
};

const { frontmatter, headings, githubEditUrl } = Astro.props as Props;

const formatter = new Intl.ListFormat("en", {
	style: "long",
	type: "conjunction",
});
const authors = frontmatter.authors && formatter.format(frontmatter.authors);
---

<article id="article" class="content flex h-full w-full max-w-[75ch] flex-col p-0">
	<section class="mb-16">
		<h1 class="content-title" id="overview">{frontmatter.title}</h1>
		{authors && <p>By {authors}</p>}
		<nav class="block min-[50em]:hidden">
			<TableOfContents headings={headings} />
		</nav>
		<slot />
	</section>
	<nav class="block min-[50em]:hidden">
		<MoreMenu editHref={githubEditUrl} />
	</nav>
</article>
