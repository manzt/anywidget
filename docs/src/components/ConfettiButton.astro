---
import {
	buttonClass,
	buttonSizeClass,
	type ButtonSize,
} from "./buttonStyles";

type Props = {
	size?: ButtonSize;
};

let { size = "xs" } = Astro.props as Props;
---

<button
	class:list={[
		buttonSizeClass[size],
		buttonClass,
	]}
	id="btn-confetti"
>
	click me!
</button>

<script type="module" is:inline>
	import confetti from "https://cdn.skypack.dev/canvas-confetti";
	let btn = document.querySelector("#btn-confetti");
	btn.addEventListener("click", () => {
		confetti();
	});
</script>
